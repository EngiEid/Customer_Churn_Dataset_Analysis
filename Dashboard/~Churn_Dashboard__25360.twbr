            <run fontname='Benton Sans Book' fontsize='10'>Churn Distribution Over Last Interaction</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> Avg Churn </run>
            <run bold='true' fontcolor='#e74d61' fontname='Benton Sans Book' fontsize='14'><![CDATA[<[federated.1g8j1k10bpq0m6140fmdj1obe5af].[sum:Calculation_1036390876890447890:qk]>]]></run>
