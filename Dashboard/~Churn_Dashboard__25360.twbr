          <datasource-dependencies datasource='federated.1g8j1k10bpq0m6140fmdj1obe5af'>
            <column caption='Tenure Group' datatype='string' name='[Calculation_1036390876521951232]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Tenure] &lt;=12 then &apos;Year&apos;&#13;&#10;ELSEIF [Tenure] &lt;=24 then &apos;2-Years&apos;&#13;&#10;ELSEIF [Tenure] &lt;=36 then &apos;3-Years&apos;&#13;&#10;ELSEIF [Tenure] &lt;=48 then &apos;4-Years&apos;&#13;&#10;ELSE &apos;5-Years&apos;&#13;&#10;END' />
            </column>
            <column caption='Churn Category' datatype='string' name='[Calculation_1036390876753801218]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Churn] = 0 THEN &apos;Retained&apos;&#13;&#10;ELSE &apos;Churned&apos;&#13;&#10;END' />
            </column>
            <column caption='Total Spend Group' datatype='string' name='[Calculation_1036390876945051667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Total Spend]&lt;=150 then &apos;150$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=200 then &apos;200$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=250 then &apos;250$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=300 then &apos;300$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=350 then &apos;350$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=400 then &apos;400$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=450 then &apos;450$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=500 then &apos;500$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=550 then &apos;550$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=600 then &apos;600$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=650 then &apos;650$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=700 then &apos;700$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=750 then &apos;750$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=800 then &apos;800$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=850 then &apos;850$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=900 then &apos;900$&apos;&#13;&#10;ELSEIF [Total Spend]&lt;=950 then &apos;950$&apos;&#13;&#10;ELSE &apos;1000$&apos;&#13;&#10;END' />
            </column>
            <column caption='Usage Frequency Group' datatype='string' name='[Calculation_1036390876957245469]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Usage Frequency] &lt;= 10 THEN &apos;10 Times&apos;&#13;&#10;ELSEIF [Usage Frequency] &lt;= 20 THEN &apos;20 Times&apos;&#13;&#10;ELSE &apos;More&apos;&#13;&#10;END' />
            </column>
            <column caption='% Diff Usage Frequency' datatype='real' name='[Calculation_1036390876958466078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG( IF [Churn] = 1 THEN [Usage Frequency] END )&#13;&#10;/&#13;&#10;AVG( IF [Churn] = 0 THEN [Usage Frequency] END )' />
            </column>
            <column caption='{[% Diff Usage Frequency]}' datatype='real' name='[Calculation_1036390876958687263]' role='measure' type='quantitative' user:unnamed='Page3_Chart4'>
              <calculation class='tableau' formula='{[Calculation_1036390876958466078]}' />
            </column>
            <column caption='Churn_Rate' datatype='real' name='[Calculation_810929419873271810]' role='measure' type='quantitative'>
