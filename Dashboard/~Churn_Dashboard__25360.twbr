            <column caption='Tenure Group' datatype='string' name='[Calculation_1036390876521951232]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Tenure] &lt;=12 then &apos;Year&apos;&#13;&#10;ELSEIF [Tenure] &lt;=24 then &apos;2-Years&apos;&#13;&#10;ELSEIF [Tenure] &lt;=36 then &apos;3-Years&apos;&#13;&#10;ELSEIF [Tenure] &lt;=48 then &apos;4-Years&apos;&#13;&#10;ELSE &apos;5-Years&apos;&#13;&#10;END' />
            </column>
            <column caption='Churn Category' datatype='string' name='[Calculation_1036390876753801218]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Churn] = 0 THEN &apos;Retained&apos;&#13;&#10;ELSE &apos;Churned&apos;&#13;&#10;END' />
            </column>
            <column caption='% Diff Support' datatype='real' name='[Calculation_1036390876876066830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG( IF [Churn] = 1 THEN [Support Calls] END )&#13;&#10;/&#13;&#10;AVG( IF [Churn] = 0 THEN [Support Calls] END )' />
            </column>
            <column caption='{[% Diff Support]}' datatype='real' name='[Calculation_1036390876876361743]' role='measure' type='quantitative' user:unnamed='Sheet 12'>
              <calculation class='tableau' formula='{[Calculation_1036390876876066830]}' />
            </column>
            <column caption='Last_Interaction_Group' datatype='string' name='[Calculation_1036390876881133584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Last Interaction] &lt;=7 THEN &apos;Weak&apos;&#13;&#10;ELSEIF [Last Interaction] &lt;=14 THEN &apos;2-Weaks&apos;&#13;&#10;ELSEIF [Last Interaction] &lt;=21 THEN &apos;3-Weaks&apos;&#13;&#10;ELSE &apos;More&apos;&#13;&#10;END' />
            </column>
            <column caption='Churn_Rate' datatype='real' name='[Calculation_810929419873271810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Churn])' />
